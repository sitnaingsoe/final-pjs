datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

// =================================================================
// 🏢 ၁။ COMPANY & BRANCH MANAGEMENT (MULTI-TENANT)
// =================================================================

model Company {
  id        String   @id @default(cuid())
  name      String // ဥပမာ - "BiteCraft Food Group"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[] // One-to-Many
}

model Branch {
  id        String  @id @default(cuid())
  name      String // ဥပမာ - "ရန်ကုန် (လှည်းတန်းဆိုင်ခွဲ)"
  address   String?
  phone     String?
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ဆိုင်ခွဲတစ်ခုချင်းစီအောက်တွင် သီးသန့်ရှိမည့် ဒေတာများ
  users          User[]
  settings       Setting?
  menuCategories MenuCategory[]
  tables         Table[]
  orders         Order[]
  discounts      Discount[]
  invoices       Invoice[] // 💡 Invoice နှင့် ချိတ်ဆက်မှု အဆင်ပြေစေရန်

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =================================================================
// 👥 ၂။ USERS & AUTHENTICATION
// =================================================================

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  name     String?
  password String
  role     UserRole @default(STAFF) // 💡 ပိုမိုစနစ်ကျစေရန် အောက်က Enum နှင့် ချိတ်ပေးထားပါသည်

  // 🎯 ဝန်ထမ်း သို့မဟုတ် Admin သည် မည်သည့်ဆိုင်ခွဲတွင် အလုပ်လုပ်သလဲ
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

// 💡 Role များကို စနစ်တကျ ထိန်းချုပ်ရန် Enum သုံးခြင်း
enum UserRole {
  COMPANY_HEAD
  BRANCH_ADMIN
  STAFF
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

// =================================================================
// ⚙️ ၃။ SYSTEM SETTINGS (BRANCH SPECIFIC)
// =================================================================

model Setting {
  id                String  @id @default(cuid())
  restaurantName    String
  currency          String  @default("MMK")
  taxRate           Float   @default(5.0)
  isAcceptingOrders Boolean @default(true)

  // 🎯 ဆိုင်ခွဲအလိုက် Setting သီးခြားစီထားခြင်း (One-to-One)
  branchId String @unique
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

// =================================================================
// 🍔 ၄။ MENU & CATEGORIES (BRANCH SPECIFIC)
// =================================================================

model MenuCategory {
  id          String     @id @default(cuid())
  name        String
  description String?
  isActive    Boolean    @default(true)
  menuItems   MenuItem[]

  // 🎯 မီနူးအမျိုးအစားများသည် မည်သည့်ဆိုင်ခွဲအတွက်လဲ
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id              String                  @id @default(cuid())
  name            String
  description     String?
  price           Float
  imageUrl        String?
  isActive        Boolean                 @default(true)
  categoryId      String
  category        MenuCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  addonCategories MenuItemAddonCategory[]
  orderItems      OrderItem[]
  discountId      String?
  discount        Discount?               @relation(fields: [discountId], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

model AddonCategory {
  id        String                  @id @default(cuid())
  name      String
  minSelect Int                     @default(0)
  maxSelect Int                     @default(1)
  addons    Addon[]
  menuItems MenuItemAddonCategory[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

model MenuItemAddonCategory {
  menuItemId      String
  addonCategoryId String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  addonCategory   AddonCategory @relation(fields: [addonCategoryId], references: [id], onDelete: Cascade)

  @@id([menuItemId, addonCategoryId])
}

model Addon {
  id              String           @id @default(cuid())
  name            String
  price           Float            @default(0.0)
  isActive        Boolean          @default(true)
  addonCategoryId String
  addonCategory   AddonCategory    @relation(fields: [addonCategoryId], references: [id], onDelete: Cascade)
  orderItemAddons OrderItemAddon[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Discount {
  id        String     @id @default(cuid())
  name      String
  type      String
  value     Float
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean    @default(true)
  menuItems MenuItem[]

  // 🎯 လျှော့စျေးများကို ဆိုင်ခွဲအလိုက် သီးခြားသတ်မှတ်ရန်
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =================================================================
// 🪑 ၅။ TABLES & ORDERS (BRANCH SPECIFIC)
// =================================================================

model Table {
  id       String  @id @default(cuid())
  number   String
  qrUrl    String?
  isActive Boolean @default(true)

  // 🎯 စားပွဲဝိုင်းများသည် မည်သည့်ဆိုင်ခွဲမှလဲ
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([number, branchId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber Int         @unique @default(autoincrement())
  status      OrderStatus @default(PENDING)
  totalAmount Float
  taxAmount   Float
  finalAmount Float
  notes       String?
  tableId     String?
  table       Table?      @relation(fields: [tableId], references: [id])

  // 🎯 အော်ဒါများကို ဆိုင်ခွဲအလိုက် တိုက်ရိုက် Query ထုတ်ရလွယ်ကူစေရန်
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // 💡 Order ဖက်ကနေ Invoice ဆီကို သေချာပြန်ညွှန်းပေးထားပါတယ် (Many-to-One)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COOKING
  READY
  DELIVERED
  CANCELLED
}

model OrderItem {
  id         String           @id @default(cuid())
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id])
  quantity   Int
  price      Float
  addons     OrderItemAddon[]
}

model OrderItemAddon {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addonId     String
  addon       Addon     @relation(fields: [addonId], references: [id])
}

// =================================================================
// 🧾 ၆။ INVOICE & PAYMENT MANAGEMENT
// =================================================================

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique // ဥပမာ - INV-2026-0001
  paymentMethod String // CASH, KPAY, CB_PAY, CREDIT_CARD
  paymentStatus PaymentStatus @default(UNPAID)

  subTotal       Float
  taxAmount      Float
  discountAmount Float @default(0.0)
  finalAmount    Float

  // 🎯 ဆိုင်ခွဲအလိုက် ဝင်ငွေခွဲခြားရန်
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // 🎯 တစ်ခါတည်း ငွေပေါင်းရှင်းနိုင်ရန် အော်ဒါများကို Link ချိတ်ခြင်း (One-to-Many)
  orders Order[] // 💡 Order မော်ဒယ်မှာ invoiceId ရှိလို့ ဒီဘက်မှာ array အနေနဲ့ လက်ခံရပါတယ်

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}
