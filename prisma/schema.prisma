datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

// =================================================================
// 🏢 ၁။ COMPANY & BRANCH MANAGEMENT (MULTI-TENANT)
// =================================================================

model Company {
  id        String   @id @default(cuid())
  name      String // ဥပမာ - "BiteCraft Food Group"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[] // One-to-Many
  users     User[] // One-to-Many (COMPANY_HEAD users linked directly to Company)
}

model Branch {
  id        String  @id @default(cuid())
  name      String // ဥပမာ - "ရန်ကုန် (လှည်းတန်းဆိုင်ခွဲ)"
  address   String?
  phone     String?
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ဆိုင်ခွဲတစ်ခုချင်းစီအောက်တွင် သီးသန့်ရှိမည့် ဒေတာများ
  users          User[]
  menuCategories MenuCategory[]
  tables         Table[]
  orders         Order[]
  discounts      Discount[]

  // Merged from Setting model
  restaurantName    String   @default("")
  currency          String   @default("MMK")
  taxRate           Float    @default(5.0)
  isAcceptingOrders Boolean  @default(true)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  addonCategories AddonCategory[]
  addons          Addon[]
}

// =================================================================
// 👥 ၂။ USERS & AUTHENTICATION
// =================================================================

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  name     String?
  password String
  role     UserRole @default(STAFF)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum UserRole {
  COMPANY_HEAD
  BRANCH_ADMIN
  STAFF
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)
}

// =================================================================
// 🍔 ၃။ MENU & CATEGORIES (BRANCH SPECIFIC)
// =================================================================

model MenuCategory {
  id          String     @id @default(cuid())
  name        String
  description String?
  isActive    Boolean    @default(true)
  menuItems   MenuItem[]

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id              String         @id @default(cuid())
  name            String
  description     String?
  price           Float
  imageUrl        String?
  isActive        Boolean        @default(true)
  isDeleted       Boolean        @default(false)
  categoryId      String
  category        MenuCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  addonCategories AddonCategory[] // Implicit Many-to-Many
  discountId      String?
  discount        Discount?      @relation(fields: [discountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AddonCategory {
  id        String     @id @default(cuid())
  name      String
  minSelect Int        @default(0)
  maxSelect Int        @default(1)
  branchId  String
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  addons    Addon[]
  menuItems MenuItem[] // Implicit Many-to-Many
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Addon {
  id              String        @id @default(cuid())
  name            String
  price           Float         @default(0.0)
  isActive        Boolean       @default(true)
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  addonCategoryId String
  addonCategory   AddonCategory @relation(fields: [addonCategoryId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Discount {
  id        String     @id @default(cuid())
  name      String
  type      String
  value     Float
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean    @default(true)
  menuItems MenuItem[]

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =================================================================
// 🪑 ၄။ TABLES & ORDERS (BRANCH SPECIFIC)
// =================================================================

model Table {
  id       String  @id @default(cuid())
  number   String
  qrUrl    String?
  isActive Boolean @default(true)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([number, branchId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     Int         @unique @default(autoincrement())
  status          OrderStatus @default(PENDING)
  totalAmount     Float
  taxAmount       Float
  finalAmount     Float
  notes           String?
  tableId         String?
  table           Table?      @relation(fields: [tableId], references: [id])
  isBillRequested Boolean     @default(false)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // 🎯 Consolidating all order items and addons in this single JSON column
  items     Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Merged from Invoice model
  invoiceNumber   String?       @unique // e.g., INV-2026-0001
  paymentMethod   String?       // CASH, KPAY, CB_PAY, CREDIT_CARD
  paymentStatus   PaymentStatus @default(UNPAID)
  discountAmount  Float         @default(0.0)
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COOKING
  READY
  DELIVERED
  PAID
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}
